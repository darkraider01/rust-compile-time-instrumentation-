+
+fn run_workload(input: &str, args: &Args, iters: u64, expected: &[u8]) -> Result<()> {
+    for _ in 0..iters {
+        let parsed = Args::try_parse_from(["toml2json", &args.input])?;
+        anyhow::ensure!(
+            parsed.input == args.input,
+            "argument parsing changed the input"
+        );
+        let value = toml::from_str::<toml::Value>(input)?;
+        let mut output = Vec::with_capacity(1024);
+        if args.pretty {
+            serde_json::to_writer_pretty(&mut output, &value)?;
+        } else {
+            serde_json::to_writer(&mut output, &value)?;
+        }
+        anyhow::ensure!(
+            output == expected,
+            "benchmark JSON differs from untouched output"
+        );
+        std::hint::black_box(&output);
+    }
     Ok(())
